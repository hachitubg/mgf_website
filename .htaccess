# Enable rewrite engine
RewriteEngine On

# Remove www if present
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# Skip rewrite for admin, api, includes, and uploads directories
RewriteCond %{REQUEST_URI} ^/(admin|api|includes|uploads)/ [NC]
RewriteRule ^ - [L]

# Redirect .php URLs to non-.php URLs for public directory
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/public/([^.]+)\.php [NC]
RewriteRule ^public/(.+)\.php$ /public/$1 [R=301,L]

# Remove .php extension from URL (internal rewrite) for public directory
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# Block direct access to includes directory
RewriteCond %{REQUEST_URI} ^/includes/ [NC]
RewriteRule ^ - [F,L]

# Default charset
AddDefaultCharset UTF-8
