    <script>

        $(document).ready(()=> {
            const body = $("body");
            const form = $('#form-contact');
            /**
             * When user click btn contact. screen will scroll down the contact
             */
            body.on('click','.btn-contact',function(e){
                e.preventDefault()
                const element = $(e.currentTarget);
                let data = {}
                data['inserted'] = false;
                data['type_default'] = element.data('type');
                data['product_default'] = element.data('product');
                $.ajax({
                    url: 'https://www.greenfeed.com.vn/thuc-an-chan-nuoi-gia-suc-gia-cam/en/handle/contact-form',
                    data: data,
                    method: 'POST',
                    success: jsonData => {
                        const repo = JSON.parse(jsonData)
                        form.find('#contact_productType').replaceWith($(repo.html).find('#contact_productType'))
                        form.find('#contact_product').replaceWith($(repo.html).find('#contact_product'))

                        $('#product-detail-modal').modal('hide');
                        if (form) {
                            document.querySelector('#form-contact').scrollIntoView({behavior: 'smooth'});
                        }
                    }
                })
            });

            /**
             * Change productType on form contact
             */
            body.on('change','#contact_productType',function(e) {
                const element = $(e.currentTarget)
                let data = {}
                data[form.find('#contact_productType').attr('name')] = element.val()
                data[form.find('#contact__token').attr('name')] = form.find('#contact__token').val()
                data['inserted'] = false

                $.ajax({
                    url: 'https://www.greenfeed.com.vn/thuc-an-chan-nuoi-gia-suc-gia-cam/en/handle/contact-form',
                    data: data,
                    method: 'POST',
                    success: jsonData => {
                        form.find('#contact_product').replaceWith($(JSON.parse(jsonData).html).find('#contact_product'))
                    }
                });
            });

            body.on('change','#contact_city',function(e){
                e.preventDefault();
                let data = {};
                data[$(this).attr('name')] = $(this).val();
                data[form.find('#contact__token').attr('name')] = form.find('#contact__token').val();
                data['inserted'] = false;
                $.ajax({
                    url: 'https://www.greenfeed.com.vn/thuc-an-chan-nuoi-gia-suc-gia-cam/en/handle/contact-form',
                    data: data,
                    method: 'POST',
                    success: jsonData => {
                        form.find('#contact_district').replaceWith($(JSON.parse(jsonData).html).find('#contact_district'));
                    }
                })
            })

            /**
             * submit form contact
             * @type {*|jQuery|HTMLElement}
             */
            form.submit(e => {
                e.preventDefault()
                $(form).ajaxSubmit({
                    success: jsonData => {
                        const repo = JSON.parse(jsonData);
                        form.find('#contact__token').replaceWith($(repo.html).find('#contact__token'));
                        $('#success').replaceWith($(repo.htmlSuccess));
                        $('#success').modal('show');
                        form.find(".form-control").val('');
                        form.find(".form-select").val('');
                        form.find("#contact_district").html(`<option value="" selected="selected">Quận huyện</option>`);
                        $('.success .btn').on('click', function(e){
                            $('#success').modal('hide');
                        });
                    },
                    error:  jsonData => {
                        console.error(jsonData.responseText)
                    }
                })
            })

            /**
             * Subscribes form email
             */
            $('#subscribe-form').submit(function(e){
                e.preventDefault()
                $(this).ajaxSubmit({
                    success: jsonData => {
                        const repo = JSON.parse(jsonData);
                        $('#success').replaceWith($(repo.htmlSuccess));
                        $('#success').modal('show');
                        $('#subscribe-form').find(".form-control").val('');
                        $('.success .btn').on('click', function(e){
                            $('#success').modal('hide');
                        });
                    },
                    error:  jsonData => {
                        console.error(jsonData.responseText)
                    }
                })
            })
        })
    </script>
      
